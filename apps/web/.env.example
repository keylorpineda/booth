# Base path of the API. In production the web app calls /api/* and Vercel rewrites it to Render,
# so the refresh cookie stays first-party. Locally, Vite proxies /api to the API dev server.
VITE_API_BASE_URL=/api
# Target of the Vite dev proxy
VITE_DEV_API_TARGET=http://localhost:3000
# Public URL of this app (used for share links and QR codes)
VITE_PUBLIC_URL=http://localhost:5173

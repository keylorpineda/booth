# --- Runtime ---
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Express "trust proxy": hop count, true/false or subnets. Production (Vercel rewrite -> Render) uses 2.
TRUST_PROXY=1
# Comma-separated allowlist of web origins
CORS_ORIGINS=http://localhost:5173
# Public URL of the web app (used to build tracking links in WhatsApp messages)
WEB_PUBLIC_URL=http://localhost:5173

# --- Database (docker-compose defaults) ---
DATABASE_URL=postgresql://booth:booth@localhost:5432/booth_dev?schema=public
# Used only by the test runner
DATABASE_URL_TEST=postgresql://booth:booth@localhost:5433/booth_test?schema=public

# --- Auth ---
# Signs access tokens (HS256). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-at-least-32-random-characters
JWT_ACCESS_TTL_MINUTES=15
# Refresh tokens are random opaque values stored hashed; no secret needed.
REFRESH_TOKEN_TTL_DAYS=30

# --- Orders ---
# The expiration window is a per-store setting (default 30 minutes).
# Secret for POST /api/internal/jobs/expire-orders (called by a scheduled GitHub Action).
# Leave empty to disable that endpoint. Generate like JWT_ACCESS_SECRET.
JOB_SECRET=

# --- Rate limiting ---
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_DEFAULT=120
RATE_LIMIT_AUTH=10
RATE_LIMIT_PUBLIC_ORDERS=20

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Lifetime of signed receipt URLs, in seconds
RECEIPT_URL_TTL_SECONDS=300
RECEIPT_MAX_BYTES=5242880

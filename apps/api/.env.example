# --- Runtime ---
NODE_ENV=development
PORT=3000
# Number of proxies in front of the API (Vercel rewrite + Render = 1..2). Used by Express "trust proxy".
TRUST_PROXY=1
# Comma-separated allowlist of web origins
CORS_ORIGINS=http://localhost:5173
# Public URL of the web app (used to build tracking links in WhatsApp messages)
WEB_PUBLIC_URL=http://localhost:5173

# --- Database (docker-compose defaults) ---
DATABASE_URL=postgresql://booth:booth@localhost:5432/booth_dev?schema=public
# Used only by the test runner
DATABASE_URL_TEST=postgresql://booth:booth@localhost:5433/booth_test?schema=public

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_TTL_DAYS=30

# --- Orders ---
ORDER_EXPIRATION_MINUTES=30

# --- Rate limiting ---
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_DEFAULT=120
RATE_LIMIT_AUTH=10
RATE_LIMIT_PUBLIC_ORDERS=20

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Lifetime of signed receipt URLs, in seconds
RECEIPT_URL_TTL_SECONDS=300
RECEIPT_MAX_BYTES=5242880

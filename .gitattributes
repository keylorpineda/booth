# Normalize all text files to LF
* text=auto eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.woff binary
*.woff2 binary
*.lottie binary
*.riv binary
*.pdf binary

# Lockfile: treat as generated in diffs
pnpm-lock.yaml linguist-generated=true -diff

{
  "name": "@booth/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Shared Zod schemas, types and helpers for Booth",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "libphonenumber-js": "^1.13.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsup": "^9.0.0",
    "vitest": "^5.0.4"
  }
}
